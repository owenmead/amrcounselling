---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
	<main class="page">
		<section class="hero hero-text tone-soft">
			<div class="container container-narrow hero-inner">
				<h1>Page not found</h1>
				<p class="lede">Sorry, that page doesn’t exist or has moved.</p>
				<div class="buttons buttons-center"><a class="button button-primary" href="/">Go to the home page</a></div>
			</div>
		</section>
	</main>
</Base>
