---
import { sanitizeImageSrc } from '@tinacms/astro/sanitize';
import type { ImageData } from '../../lib/data';

interface Props {
	image?: ImageData | null;
	field?: string;
	class?: string;
	eager?: boolean;
	sizes?: string;
}

const { image, field, class: className, eager = false } = Astro.props;
const src = sanitizeImageSrc(image?.src);
---
{src ? (
	<img
		src={src}
		alt={image?.alt ?? ''}
		class:list={['photo', className]}
		loading={eager ? 'eager' : 'lazy'}
		fetchpriority={eager ? 'high' : undefined}
		decoding="async"
		data-tina-field={field}
	/>
) : (
	<div class:list={['photo', 'photo-empty', className]} data-tina-field={field}>
		<span>Add a photo</span>
	</div>
)}
