---
import { tinaField } from '@tinacms/astro/tina-field';
import { sanitizeImageSrc } from '@tinacms/astro/sanitize';
import { menuHref, resolveLink } from '../lib/links';
import type { Settings } from '../lib/data';

interface Props { settings?: Settings | null }

const { settings } = Astro.props;
type NavEntry = { label?: string | null; page?: unknown; link?: string | null };
// A picked page supplies the address and, if no text was typed, the label.
const toItem = (item: NavEntry) => ({
	label: item.label || (item.page as { title?: string } | null)?.title || '',
	href: menuHref(item),
	field: item,
});
const nav = (settings?.nav ?? []).flatMap((n) => {
	if (!n) return [];
	const children = (n.children ?? []).flatMap((c) => (c ? [toItem(c)] : [])).filter((c) => c.label && c.href);
	const item = toItem(n);
	// Keep a parent with no page of its own if it still has drop-down items.
	if (!item.label || (!item.href && children.length === 0)) return [];
	return [{ ...item, children }];
});
const logo = sanitizeImageSrc(settings?.logo);
---
<header class="site-header">
	<div class="container header-inner">
		<a href="/" class="brand">
			{logo && <img src={logo} alt="" class="brand-logo" data-tina-field={settings ? tinaField(settings, 'logo') : undefined} />}
			<span data-tina-field={settings ? tinaField(settings, 'siteName') : undefined}>{settings?.siteName}</span>
		</a>
		<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
			<span class="sr-only">Menu</span>
			<span class="menu-bars" aria-hidden="true"></span>
		</button>
		<nav id="site-nav" class="site-nav" aria-label="Main">
			<ul>
				{nav.map((item) => (
					<li class:list={[item.children.length > 0 && 'has-children']} data-tina-field={tinaField(item.field as Parameters<typeof tinaField>[0])}>
						{item.href ? <a href={item.href}>{item.label}</a> : <span class="nav-label">{item.label}</span>}
						{item.children.length > 0 && (
							<ul class="submenu">
								{item.children.map((child) => (
									<li><a href={child.href} data-tina-field={tinaField(child.field as Parameters<typeof tinaField>[0])}>{child.label}</a></li>
								))}
							</ul>
						)}
					</li>
				))}
			</ul>
			{settings?.bookingUrl && (
				<a
					class="button button-primary button-small"
					href={resolveLink(settings.bookingUrl)}
					target="_blank"
					rel="noopener"
					data-tina-field={tinaField(settings, 'bookingLabel')}
				>{settings.bookingLabel || 'Book a session'}</a>
			)}
		</nav>
	</div>
</header>
<script is:inline>
	if (!window.__menuBound) {
		window.__menuBound = true;
		document.addEventListener('click', (e) => {
			const btn = e.target.closest('.menu-toggle');
			if (!btn) return;
			const open = btn.getAttribute('aria-expanded') !== 'true';
			btn.setAttribute('aria-expanded', String(open));
			document.documentElement.classList.toggle('menu-open', open);
		});
	}
</script>
