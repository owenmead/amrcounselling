---
import { tinaField } from '@tinacms/astro/tina-field';
import Section from '../ui/Section.astro';
import Photo from '../ui/Photo.astro';
import Text from '../ui/Text.astro';
import { resolveLink } from '../../lib/links';
import type { CardsBlock } from '../../lib/data';

interface Props { data: CardsBlock }

const { data } = Astro.props;
const items = (data.items ?? []).filter((i) => i !== null);
---
<Section tone={data.tone}>
	{(data.heading || data.intro) && (
		<header class="section-header">
			{data.heading && <h2 data-tina-field={tinaField(data, 'heading')}>{data.heading}</h2>}
			<Text content={data.intro} field={tinaField(data, 'intro')} class="lede" />
		</header>
	)}
	<div class:list={['cards', `cards-${data.columns || '3'}`]}>
		{items.map((item) => (
			// A linked card is clickable everywhere via a stretched link on the
			// title, so links inside the card text stay valid (no nested <a>).
			<div class:list={['card', item.link && 'card-linked']} data-tina-field={tinaField(item)}>
				{item.image?.src && <Photo image={item.image} field={tinaField(item, 'image')} class="shape-landscape" sizes="(min-width: 52rem) 24rem, 100vw" />}
				<div class="card-body">
					{item.title && (
						<h3 data-tina-field={tinaField(item, 'title')}>
							{item.link ? <a class="card-link" href={resolveLink(item.link)}>{item.title}</a> : item.title}
						</h3>
					)}
					<Text content={item.text} field={tinaField(item, 'text')} />
					{item.link && <span class="card-more" aria-hidden="true">Learn more →</span>}
				</div>
			</div>
		))}
	</div>
</Section>
